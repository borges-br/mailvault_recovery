<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ============================================================
         MailVault Recovery — Design Tokens (Dark + Light)
         Paleta baseada na logo (violeta #9283F4). Troca ao vivo via
         ThemeVariant; as Views consomem por DynamicResource.
         Apenas 3 chaves são usadas como <Color> (gradientes):
         AccentColor, AccentStrongColor, AccentGlowColor.
         ============================================================ -->
    <ResourceDictionary.ThemeDictionaries>

        <!-- ===================== DARK ===================== -->
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="AccentColor">#9283F4</Color>
            <Color x:Key="AccentStrongColor">#7F6EF0</Color>
            <Color x:Key="AccentGlowColor">#249283F4</Color>

            <SolidColorBrush x:Key="BgAppBrush" Color="#0F1020"/>
            <SolidColorBrush x:Key="BgSurfaceBrush" Color="#1B1D35"/>
            <SolidColorBrush x:Key="BgSurfaceAltBrush" Color="#15162A"/>
            <SolidColorBrush x:Key="BgElevatedBrush" Color="#222542"/>
            <SolidColorBrush x:Key="BgInputBrush" Color="#0C0D1C"/>

            <SolidColorBrush x:Key="BorderSubtleBrush" Color="#2A2D4A"/>
            <SolidColorBrush x:Key="BorderStrongBrush" Color="#3A3D5E"/>

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CFCDE0"/>
            <SolidColorBrush x:Key="TextMutedBrush" Color="#B8B6CC"/>
            <SolidColorBrush x:Key="TextDisabledBrush" Color="#6E6C85"/>

            <SolidColorBrush x:Key="AccentBrush" Color="#9283F4"/>
            <SolidColorBrush x:Key="AccentStrongBrush" Color="#7F6EF0"/>
            <SolidColorBrush x:Key="AccentContrastBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="AccentGlowBrush" Color="#249283F4"/>
            <SolidColorBrush x:Key="AccentLineBrush" Color="#529283F4"/>
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#A99CF7"/>

            <SolidColorBrush x:Key="SuccessBrush" Color="#34D399"/>
            <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24"/>
            <SolidColorBrush x:Key="DangerBrush" Color="#F87171"/>
            <SolidColorBrush x:Key="InfoBrush" Color="#60A5FA"/>
            <SolidColorBrush x:Key="ExperimentalBrush" Color="#C084FC"/>

            <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#102A20"/>
            <SolidColorBrush x:Key="WarningSubtleBrush" Color="#2C2310"/>
            <SolidColorBrush x:Key="DangerSubtleBrush" Color="#2A1414"/>
            <SolidColorBrush x:Key="InfoSubtleBrush" Color="#14203A"/>
            <SolidColorBrush x:Key="ExperimentalSubtleBrush" Color="#211A38"/>
        </ResourceDictionary>

        <!-- ===================== LIGHT ===================== -->
        <ResourceDictionary x:Key="Light">
            <Color x:Key="AccentColor">#7C6BEF</Color>
            <Color x:Key="AccentStrongColor">#5A48D6</Color>
            <Color x:Key="AccentGlowColor">#1F7C6BEF</Color>

            <SolidColorBrush x:Key="BgAppBrush" Color="#F5F3FF"/>
            <SolidColorBrush x:Key="BgSurfaceBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="BgSurfaceAltBrush" Color="#ECE9FB"/>
            <SolidColorBrush x:Key="BgElevatedBrush" Color="#FAF9FF"/>
            <SolidColorBrush x:Key="BgInputBrush" Color="#FFFFFF"/>

            <SolidColorBrush x:Key="BorderSubtleBrush" Color="#DDD7FE"/>
            <SolidColorBrush x:Key="BorderStrongBrush" Color="#C4BCF2"/>

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#171625"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#3A3650"/>
            <SolidColorBrush x:Key="TextMutedBrush" Color="#5F5A72"/>
            <SolidColorBrush x:Key="TextDisabledBrush" Color="#A29DB5"/>

            <SolidColorBrush x:Key="AccentBrush" Color="#7C6BEF"/>
            <SolidColorBrush x:Key="AccentStrongBrush" Color="#5A48D6"/>
            <SolidColorBrush x:Key="AccentContrastBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="AccentGlowBrush" Color="#1F7C6BEF"/>
            <SolidColorBrush x:Key="AccentLineBrush" Color="#4D7C6BEF"/>
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#6B5AE6"/>

            <SolidColorBrush x:Key="SuccessBrush" Color="#059669"/>
            <SolidColorBrush x:Key="WarningBrush" Color="#D97706"/>
            <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>
            <SolidColorBrush x:Key="InfoBrush" Color="#2563EB"/>
            <SolidColorBrush x:Key="ExperimentalBrush" Color="#9333EA"/>

            <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#DCFCE7"/>
            <SolidColorBrush x:Key="WarningSubtleBrush" Color="#FEF3C7"/>
            <SolidColorBrush x:Key="DangerSubtleBrush" Color="#FEE2E2"/>
            <SolidColorBrush x:Key="InfoSubtleBrush" Color="#DBEAFE"/>
            <SolidColorBrush x:Key="ExperimentalSubtleBrush" Color="#F3E8FF"/>
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- ============================================================
         Tokens invariantes (não mudam com o tema)
         ============================================================ -->

    <!-- A logo usa muito branco; mantém um container escuro-violeta em
         ambos os temas para ela não "sumir" no tema claro. -->
    <SolidColorBrush x:Key="LogoContainerBrush" Color="#2A2550"/>
    <SolidColorBrush x:Key="LogoContainerBorderBrush" Color="#3A3370"/>

    <!-- Fonts — Inter embarcada via .WithInterFont(); mono cai p/ Cascadia/Consolas. -->
    <FontFamily x:Key="FontUI">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
    <FontFamily x:Key="FontMono">JetBrains Mono, Cascadia Mono, Consolas, monospace</FontFamily>

    <!-- Geometria / layout -->
    <CornerRadius x:Key="RadiusSm">5</CornerRadius>
    <CornerRadius x:Key="Radius">8</CornerRadius>
    <CornerRadius x:Key="RadiusLg">12</CornerRadius>
    <CornerRadius x:Key="RadiusXl">16</CornerRadius>

    <x:Double x:Key="TopBarHeight">54</x:Double>
    <x:Double x:Key="StatusBarHeight">30</x:Double>
    <x:Double x:Key="SidebarWidth">260</x:Double>
</ResourceDictionary>
