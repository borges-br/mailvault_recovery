<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\MailVault.Domain\MailVault.Domain.csproj" />
    <ProjectReference Include="..\MailVault.Core\MailVault.Core.csproj" />
    <ProjectReference Include="..\MailVault.Audit\MailVault.Audit.csproj" />
    <ProjectReference Include="..\MailVault.Indexing\MailVault.Indexing.csproj" />
    <ProjectReference Include="..\MailVault.Exporters.Eml\MailVault.Exporters.Eml.csproj" />
    <ProjectReference Include="..\MailVault.Exporters.Mbox\MailVault.Exporters.Mbox.csproj" />
    <ProjectReference Include="..\MailVault.Validation\MailVault.Validation.csproj" />
    <!-- Copy-only plugin dependency: garante que o adapter OST/PST e XstReader.Api.dll
         sejam copiados (frescos) para a saída do CLI. Sem isto, builds de desenvolvimento
         rodam contra um plugin desatualizado e os comandos recover-* falham. -->
    <ProjectReference Include="..\MailVault.Adapters.XstReader\MailVault.Adapters.XstReader.csproj">
      <Private>true</Private>
      <CopyLocalSatelliteAssemblies>true</CopyLocalSatelliteAssemblies>
    </ProjectReference>
    <ProjectReference Include="..\MailVault.Adapters.Libpff\MailVault.Adapters.Libpff.csproj">
      <Private>true</Private>
      <CopyLocalSatelliteAssemblies>true</CopyLocalSatelliteAssemblies>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>mailvault</AssemblyName>
  </PropertyGroup>

</Project>
